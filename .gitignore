.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.keys
*.keylog
sslkeylog*

# Raw network captures stay local; add sanitized fixtures explicitly if needed.
*.pcap
*.pcapng
*.cap
*.etl

